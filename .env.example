# ---- Required in production ----
NODE_ENV=development
# PostgreSQL connection string
DATABASE_URL=postgres://timcheck:timcheck@localhost:5432/timcheck
# Set to true for most hosted databases (Render, Neon, Supabase, Railway)
DATABASE_SSL=false
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Public address of the site (used in PDF footers and verification links)
APP_URL=http://localhost:3000
PORT=3000

# ---- Optional ----
# Comma-separated emails that become admins when they register or log in
ADMIN_EMAILS=
# File storage: local (folder on the server) or s3 (any S3-compatible bucket)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

MAX_UPLOAD_MB=10
# Uploads allowed per user per hour
UPLOADS_PER_HOUR=120
MAX_PASTE_CHARS=200000
MAX_WORDS_CHECKED=60000
# Background worker: run inside the web server (true) or as a separate process (false + npm run worker)
RUN_WORKER_IN_WEB=true
WORKER_CONCURRENCY=2
# Time zone printed on PDF reports
REPORT_TIMEZONE=UTC
